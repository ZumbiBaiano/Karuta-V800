[Unit]
Description=Karuta auto-pick bot
After=default.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{PROJECT_DIR}}

# Browser GUI via WSLg precisa dessas variaveis
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/{{UID}}
Environment=PULSE_SERVER=unix:/mnt/wslg/PulseServer
Environment=PYTHONUNBUFFERED=1

ExecStart={{PROJECT_DIR}}/.venv/bin/karuta start

# Reinicia em caso de falha
Restart=on-failure
RestartSec=30

# Recicla a cada 24h. O Chromium vaza ~50 MB/h (medido em 3h de operacao,
# tendencia +51 MB/h), entao em um dia o conjunto sai de ~2,5 GB para ~4 GB.
# Nao e vazamento rapido o bastante pra justificar reload de aba no meio da
# operacao — reiniciar o processo inteiro uma vez por dia resolve, e cai no
# Restart=on-failure acima porque o systemd marca RuntimeMaxSec como falha.
RuntimeMaxSec=86400

# Logs vao para journald (acessivel via journalctl)
StandardOutput=journal
StandardError=journal

# Limites de seguranca
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGINT

[Install]
WantedBy=default.target
